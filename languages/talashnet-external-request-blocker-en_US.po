msgid "مسدودکننده سایت‌های خارجی"
msgstr "External Sites Blocker"

msgid "مسدودکننده خارجی"
msgstr "External Blocker"

msgid "مدیریت و کنترل دسترسی به منابع خارجی (افزونه اینترنت ملی)"
msgstr "Manage and control access to external resources (Internet Melli Plugin)"

msgid "خطای امنیتی"
msgstr "Security Error"

